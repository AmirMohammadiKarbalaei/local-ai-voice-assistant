/ example .env file for Jarvis
# Copy this file to .env and fill in the values before running the program.
OLLAMA_URL=http://localhost:11434/api/chat

FAST_MODEL = "qwen3:4b-instruct"

SMART_MODEL = "qwen3:8b"

USER_LOCATION=City, Country
USER_TIMEZONE=  Region/City

MIC_DEVICE_INDEX=2

ENABLE_WEB_SEARCH=true
TAVILY_API_KEY= TAVILY_API_KEY

USER_LATITUDE= USER_LATITUDE
USER_LONGITUDE= USER_LONGITUDE

# Kokoro TTS
KOKORO_VOICE=bm_george
KOKORO_SPEED=1.3
KOKORO_LANG_CODE=b
KOKORO_REPO_ID=hexgrad/Kokoro-82M


# Conversation control
# These start a conversation with Jarvis from idle mode.
START_WORDS=hey jarvis,hi jarvis,ok jarvis,okay jarvis,jorvis,jervice,jarvis, gorvis,garvis,jarviss,jarvisss,jarvis's,jarvis is,jarvis do you,jarvis can you,jarvis what about,jarvis what is,jarvis who is,jarvis how do,jarvis how can,jarvis why do,jarvis why can

# These leave conversation mode but keep the program running.
CONVERSATION_STOP_WORDS=bye,goodbye,stop,stop listening,that's all,that is all,thanks jarvis,thank you jarvis

# These fully close the Python program.
SHUTDOWN_WORDS=jarvis shut down,jarvis shutdown,jarvis sleep,jarvis exit,jarvis quit,jarvis close, shut down


# Speech recognition
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

SPEECH_TIMEOUT=8
SPEECH_PHRASE_TIME_LIMIT=12
SPEECH_PAUSE_THRESHOLD=0.9
SPEECH_ENERGY_THRESHOLD=500

ENABLE_LLM_TOOL_ROUTER=true
ROUTER_CONFIDENCE_THRESHOLD=0.65
ROUTER_CONFIRM_THRESHOLD=0.80

SOUND_EFFECTS_ENABLED=true
SOUND_EFFECT_VOLUME=0.18
SOUND_EFFECT_SAMPLE_RATE=24000